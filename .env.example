# Copiar a .env y ajustar. Solo para desarrollo local: lo leen docker compose y el backend (perfil dev).
DB_NAME=vastio
DB_USER=vastio
DB_PASSWORD=vastio
DB_PORT=5432

# Usuario inicial de Dirección que crea el backend al arrancar en dev (si no existe).
VASTIO_ADMIN_USUARIO=direccion
VASTIO_ADMIN_CONTRASENA=

# Datos de demostración (solo dev): un usuario por perfil (lucia.ferreyra, sofia.mendez, melina.sifon, ...)
# y eventos (pre-reservas y señados) en las próximas semanas. Todos con esta contraseña. Vacía: no se cargan.
VASTIO_DEMO_CONTRASENA=

# M-06 optativa: ver docs/m-06-google-calendar.md. Nunca guardar claves aquí.
VASTIO_CALENDAR_HABILITADO=false
VASTIO_CALENDAR_ID=
VASTIO_CALENDAR_INSTALACION=
VASTIO_CALENDAR_CREDENCIALES=
# Solo con docker-compose.calendar.yml; archivo existente fuera del repositorio.
VASTIO_CALENDAR_CREDENCIALES_HOST=
