# Copiar a .env y ajustar. Solo para desarrollo local: lo leen docker compose y el backend (perfil dev).
DB_NAME=vastio
DB_USER=vastio
DB_PASSWORD=vastio
DB_PORT=5432

# Usuario inicial de Dirección que crea el backend al arrancar en dev (si no existe).
VASTIO_ADMIN_USUARIO=direccion
VASTIO_ADMIN_CONTRASENA=

# Datos de demostración (solo dev): un usuario por perfil (lucia.ferreyra, sofia.mendez, melina.sifon, ...)
# y pre-reservas en las próximas semanas. Todos con esta contraseña. Vacía: no se cargan.
VASTIO_DEMO_CONTRASENA=
