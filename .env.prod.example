# Copiar a .env.prod en el servidor y completar. Nunca se versiona.

# Dominio del ambiente de prueba; Caddy obtiene el certificado HTTPS para él.
# Sin dominio propio sirve un subdominio gratuito, p. ej. 203-0-113-7.sslip.io (con la IP pública del servidor).
DOMINIO=

DB_NAME=vastio
DB_USER=vastio
# Identificador unico de esta instalacion; no reutilizar entre entornos.
# Solo letras, numeros, guion y guion bajo. No es una credencial.
RESPALDO_ENTORNO=
# Transferencia opcional (solo con docker-compose.respaldo-externo.yml).
# Directorio absoluto EXTERNO al repositorio, ya existente; nunca tokens aqui.
RCLONE_CONFIG_DIR=
# Nombre de remoto configurado externamente y carpeta, sin URI ni credenciales.
RCLONE_DESTINO=
# Generar con: openssl rand -base64 24
DB_PASSWORD=

# Clave para firmar los tokens; al menos 32 caracteres. Generar con: openssl rand -base64 48
VASTIO_JWT_SECRETO=

# Solo para la primera puesta en marcha (después dejar ambas vacías y reiniciar el backend).
SPRING_PROFILES_ACTIVE=
VASTIO_ADMIN_USUARIO=direccion
VASTIO_ADMIN_CONTRASENA=
